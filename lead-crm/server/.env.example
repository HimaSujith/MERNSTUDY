NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/lead-crm
# Optional: comma-separated DNS servers to use for resolution, only needed if your
# network's DNS fails to resolve MongoDB Atlas SRV records (e.g. "querySrv ECONNREFUSED").
# DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_ACCESS_SECRET=changeme_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM="Lead CRM <no-reply@example.com>"

SEED_ADMIN_NAME="Admin User"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme_strong_password

ENABLE_CRON=true
REMINDER_CRON_SCHEDULE=*/5 * * * *
